{
  "name": "Daily Attendance Reminders",
  "description": "Emails teachers whose classes still need attendance taken today, each weekday afternoon",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_attendance_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAttendanceReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send attendance reminders",
            "description": "Email teachers with pending attendance"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 15 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}