  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "export_monitoring",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_exports": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkExportThresholds",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check export thresholds",
            "description": "Scans 24h export volume and logs alerts"
          }
        }
      }
    ]
