{
  "name": "StudentClass",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "academic_year_id": {
      "type": "string",
      "title": "Academic Year ID"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "withdrawn",
        "completed"
      ],
      "default": "active"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    }
  },
  "required": [
    "student_id",
    "class_id",
    "school_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}