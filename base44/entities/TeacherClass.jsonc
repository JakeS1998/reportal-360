{
  "name": "TeacherClass",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "title": "Teacher ID"
    },
    "teacher_name": {
      "type": "string",
      "title": "Teacher Name"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "Primary Teacher",
        "Secondary Teacher",
        "Assistant Teacher",
        "Co-Teacher",
        "Substitute"
      ],
      "default": "Primary Teacher"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    }
  },
  "required": [
    "teacher_id",
    "class_id",
    "role",
    "school_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}