{
  "name": "StaffMessage",
  "type": "object",
  "properties": {
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "thread_id": {
      "type": "string",
      "title": "Conversation Thread ID"
    },
    "sender_id": {
      "type": "string",
      "title": "Sender ID"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender Name"
    },
    "recipient_id": {
      "type": "string",
      "title": "Recipient ID"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient Name"
    },
    "type": {
      "type": "string",
      "title": "Message Type",
      "enum": [
        "message",
        "alert"
      ],
      "default": "message"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Message"
    },
    "current_path": {
      "type": "string",
      "title": "Reported Screen Path"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "title": "Read At"
    }
  },
  "required": [
    "school_code",
    "sender_id",
    "recipient_id",
    "type",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}