{
  "name": "AssignmentSubmission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Assignment ID"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "file_url": {
      "type": "string",
      "format": "uri",
      "title": "Assignment Submission File URL"
    },
    "file_name": {
      "type": "string",
      "title": "Assignment Submission File Name"
    },
    "ai_report_file_url": {
      "type": "string",
      "format": "uri",
      "title": "AI/Plagiarism Report File URL"
    },
    "ai_report_file_name": {
      "type": "string",
      "title": "AI/Plagiarism Report File Name"
    },
    "submission_text": {
      "type": "string",
      "title": "Submission Text"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    },
    "teacher_viewed_by": {
      "type": "array",
      "title": "Viewed By",
      "items": {
        "type": "object",
        "properties": {
          "teacher_id": {
            "type": "string"
          },
          "teacher_name": {
            "type": "string"
          },
          "viewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "grade_percentage": {
      "type": "number",
      "title": "Grade Percentage"
    },
    "letter_grade": {
      "type": "string",
      "title": "Letter Grade",
      "enum": [
        "A+",
        "A",
        "A-",
        "B+",
        "B",
        "B-",
        "C+",
        "C",
        "C-",
        "D+",
        "D",
        "D-",
        "F"
      ]
    },
    "feedback": {
      "type": "string",
      "title": "Teacher Feedback"
    },
    "grade_released": {
      "type": "boolean",
      "default": false,
      "title": "Grade Released"
    },
    "grade_released_at": {
      "type": "string",
      "format": "date-time",
      "title": "Grade Released At"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "late",
        "missing",
        "viewed"
      ],
      "default": "submitted",
      "title": "Status"
    }
  },
  "required": [
    "assignment_id",
    "student_id",
    "submitted_at",
    "status"
  ]
}