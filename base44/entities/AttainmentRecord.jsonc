{
  "name": "AttainmentRecord",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "assessment_name": {
      "type": "string",
      "title": "Assessment Name"
    },
    "assignment_type": {
      "type": "string",
      "title": "Assignment Type",
      "enum": [
        "classwork",
        "quiz",
        "test",
        "essay",
        "project",
        "homework",
        "presentation",
        "other"
      ],
      "default": "classwork"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "score": {
      "type": "number",
      "title": "Score"
    },
    "max_score": {
      "type": "number",
      "title": "Max Score",
      "default": 100
    },
    "letter_grade": {
      "type": "string",
      "title": "Letter Grade",
      "enum": [
        "A+",
        "A",
        "A-",
        "B+",
        "B",
        "B-",
        "C+",
        "C",
        "C-",
        "D+",
        "D",
        "D-",
        "F"
      ]
    },
    "submission_status": {
      "type": "string",
      "title": "Submission Status",
      "enum": [
        "submitted",
        "late",
        "missed"
      ],
      "default": "submitted"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    }
  },
  "required": [
    "student_id",
    "class_id",
    "assessment_name"
  ]
}