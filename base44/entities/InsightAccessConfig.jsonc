{
  "name": "InsightAccessConfig",
  "type": "object",
  "properties": {
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "allowed_teacher_metrics": {
      "type": "array",
      "title": "Teacher Insight Metrics",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "school_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}