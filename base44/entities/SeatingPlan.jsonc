{
  "name": "SeatingPlan",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "seats": {
      "type": "array",
      "title": "Seats",
      "items": {
        "type": "object",
        "properties": {
          "seat_id": {
            "type": "string"
          },
          "student_id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "seat_id",
          "x",
          "y"
        ]
      }
    }
  },
  "required": [
    "class_id",
    "school_code",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}