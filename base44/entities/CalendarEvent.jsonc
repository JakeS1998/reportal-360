{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "creator_id": {
      "type": "string",
      "title": "Creator ID"
    },
    "creator_name": {
      "type": "string",
      "title": "Creator Name"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "meeting",
        "reminder",
        "todo",
        "pep_rally",
        "sports_game",
        "field_trip",
        "assembly",
        "drill",
        "other"
      ],
      "title": "Event Type"
    },
    "drill_type": {
      "type": "string",
      "title": "Drill Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "monthly"
      ],
      "default": "none",
      "title": "Recurrence"
    },
    "affected_student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Affected Students"
    },
    "affected_teacher_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Affected Teachers"
    },
    "is_school_wide": {
      "type": "boolean",
      "default": false,
      "title": "All Students"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "personal",
        "school_event",
        "drill"
      ],
      "title": "Visibility"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ],
      "default": "active",
      "title": "Status"
    }
  },
  "required": [
    "school_code",
    "creator_id",
    "event_type",
    "title",
    "date",
    "start_time",
    "end_time",
    "recurrence",
    "visibility"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}