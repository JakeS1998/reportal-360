{
  "name": "Class",
  "type": "object",
  "properties": {
    "class_name": {
      "type": "string",
      "title": "Class Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "school_name": {
      "type": "string",
      "title": "School Name"
    },
    "academic_year_id": {
      "type": "string",
      "title": "Academic Year ID"
    },
    "grade_level": {
      "type": "string",
      "title": "Grade Level"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "period": {
      "type": "string",
      "title": "Period"
    },
    "room": {
      "type": "string",
      "title": "Room"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "archived",
        "draft"
      ],
      "default": "active"
    },
    "teacher_name": {
      "type": "string",
      "title": "Teacher Name"
    },
    "year": {
      "type": "string",
      "title": "Academic Year Label"
    }
  },
  "required": [
    "class_name",
    "school_code"
  ]
}