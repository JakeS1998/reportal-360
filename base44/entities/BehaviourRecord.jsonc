{
  "name": "BehaviourRecord",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "positive",
        "warning",
        "minor",
        "major"
      ],
      "title": "Incident Type"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "default": "low"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "action_taken": {
      "type": "string",
      "title": "Action Taken"
    }
  },
  "required": [
    "student_id",
    "class_id",
    "date",
    "incident_type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}