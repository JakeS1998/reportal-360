{
  "name": "ClassSchedule",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "class_name": {
      "type": "string",
      "title": "Class Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "teacher_id": {
      "type": "string",
      "title": "Teacher ID"
    },
    "teacher_name": {
      "type": "string",
      "title": "Teacher Name"
    },
    "room": {
      "type": "string",
      "title": "Room"
    },
    "day_of_week": {
      "type": "string",
      "title": "Day of Week",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "recurrence_type": {
      "type": "string",
      "title": "Recurrence",
      "enum": [
        "none",
        "weekly",
        "biweekly"
      ],
      "default": "none"
    },
    "recurrence_weeks": {
      "type": "number",
      "title": "Recurrence Weeks",
      "default": 1
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    }
  },
  "required": [
    "class_id",
    "school_code",
    "day_of_week",
    "start_time",
    "end_time"
  ]
}