{
  "name": "ClassSchedule",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "class_name": {
      "type": "string",
      "title": "Class Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "academic_year_id": {
      "type": "string",
      "title": "Academic Year ID"
    },
    "schedule_type": {
      "type": "string",
      "title": "Scheduling Model",
      "enum": [
        "traditional",
        "rotating_block",
        "flexible_weekly"
      ]
    },
    "day_type": {
      "type": "string",
      "title": "Cycle Day Type"
    },
    "period_label": {
      "type": "string",
      "title": "Slot or Period Label"
    },
    "teacher_id": {
      "type": "string",
      "title": "Teacher ID"
    },
    "teacher_name": {
      "type": "string",
      "title": "Teacher Name"
    },
    "room": {
      "type": "string",
      "title": "Room"
    },
    "day_of_week": {
      "type": "string",
      "title": "Day of Week or Cycle Day"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "meeting_url": {
      "type": "string",
      "format": "uri",
      "title": "Meeting Link"
    },
    "recurrence_type": {
      "type": "string",
      "title": "Recurrence",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "cycle"
      ],
      "default": "none"
    },
    "recurrence_weeks": {
      "type": "number",
      "title": "Recurrence Weeks",
      "default": 1
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "locked": {
      "type": "boolean",
      "title": "Locked Slot",
      "default": false
    }
  },
  "required": [
    "class_id",
    "school_code",
    "day_of_week",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}