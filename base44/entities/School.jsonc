{
  "name": "School",
  "type": "object",
  "properties": {
    "school_name": {
      "type": "string",
      "title": "School Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "system_code": {
      "type": "string",
      "title": "System Code"
    },
    "system_name": {
      "type": "string",
      "title": "System Name"
    },
    "district": {
      "type": "string",
      "title": "District"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "grade_span": {
      "type": "string",
      "title": "Grade Span"
    },
    "school_type": {
      "type": "string",
      "title": "School Type",
      "enum": [
        "Elementary",
        "Middle",
        "High",
        "K-12",
        "Other"
      ]
    },
    "enrollment": {
      "type": "number",
      "title": "Enrollment"
    },
    "academic_achievement": {
      "type": "number",
      "title": "Academic Achievement Score"
    },
    "academic_growth": {
      "type": "number",
      "title": "Academic Growth Score"
    },
    "chronic_absenteeism": {
      "type": "number",
      "title": "Chronic Absenteeism (%)"
    },
    "graduation_rate": {
      "type": "number",
      "title": "Graduation Rate (%)"
    },
    "math_proficiency": {
      "type": "number",
      "title": "Math Proficiency (%)"
    },
    "reading_proficiency": {
      "type": "number",
      "title": "Reading Proficiency (%)"
    },
    "science_proficiency": {
      "type": "number",
      "title": "Science Proficiency (%)"
    },
    "year": {
      "type": "string",
      "title": "Report Year"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "title": "School Logo URL"
    },
    "header_color": {
      "type": "string",
      "title": "Header Color"
    },
    "menu_text_color": {
      "type": "string",
      "title": "Menu Text Color"
    }
  },
  "required": [
    "school_name",
    "school_code"
  ]
}