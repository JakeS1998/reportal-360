{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "login_success",
        "login_failed",
        "login_locked",
        "user_created",
        "user_deleted",
        "user_updated",
        "password_reset",
        "password_reset_admin",
        "data_export",
        "admin_action",
        "view_student",
        "search_student",
        "edit_student",
        "view_assessment",
        "view_attendance",
        "view_discipline"
      ]
    },
    "action_type": {
      "type": "string",
      "title": "Action Type"
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "user_role": {
      "type": "string",
      "title": "User Role"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "system_code": {
      "type": "string",
      "title": "System/District Code"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "ip_address": {
      "type": "string",
      "title": "IP Address"
    },
    "user_agent": {
      "type": "string",
      "title": "Browser/User Agent"
    },
    "success": {
      "type": "boolean",
      "title": "Success",
      "default": true
    },
    "export_format": {
      "type": "string",
      "title": "Export Format"
    },
    "export_record_count": {
      "type": "number",
      "title": "Export Record Count"
    },
    "report_name": {
      "type": "string",
      "title": "Report Name"
    },
    "details": {
      "type": "string",
      "title": "Details"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}