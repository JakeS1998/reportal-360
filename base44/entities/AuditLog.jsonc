{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "login_success",
        "login_failed",
        "login_locked",
        "user_created",
        "user_deleted",
        "user_updated",
        "password_reset",
        "password_reset_admin",
        "data_export",
        "admin_action"
      ]
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "user_role": {
      "type": "string",
      "title": "User Role"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "details": {
      "type": "string",
      "title": "Details"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}