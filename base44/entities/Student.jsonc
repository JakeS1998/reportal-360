{
  "name": "Student",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "student_number": {
      "type": "string",
      "title": "Student Number"
    },
    "state_student_id": {
      "type": "string",
      "title": "State Student ID"
    },
    "grade_level": {
      "type": "string",
      "title": "Grade Level"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "homeroom": {
      "type": "string",
      "title": "Homeroom"
    },
    "transportation": {
      "type": "string",
      "title": "Transportation",
      "enum": [
        "Bus Rider",
        "Pickup"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "transferred"
      ],
      "default": "active"
    },
    "gender": {
      "type": "string",
      "title": "Gender",
      "enum": [
        "Male",
        "Female"
      ]
    },
    "race_ethnicity": {
      "type": "string",
      "title": "Race/Ethnicity",
      "enum": [
        "White",
        "Black",
        "Hispanic",
        "Asian",
        "American Indian",
        "Two or more",
        "Native Hawaiian"
      ]
    },
    "economically_disadvantaged": {
      "type": "boolean",
      "title": "Economically Disadvantaged",
      "default": false
    },
    "english_learner": {
      "type": "boolean",
      "title": "English Learner",
      "default": false
    },
    "disability": {
      "type": "boolean",
      "title": "Has Disability",
      "default": false
    },
    "lunch_status": {
      "type": "string",
      "title": "Lunch Status",
      "enum": [
        "Free",
        "Reduced",
        "Paid"
      ]
    },
    "address_line_1": {
      "type": "string",
      "title": "Address Line 1"
    },
    "address_line_2": {
      "type": "string",
      "title": "Address Line 2"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "postal_code": {
      "type": "string",
      "title": "Postal Code"
    },
    "allergies": {
      "type": "array",
      "title": "Allergies",
      "items": {
        "type": "string"
      }
    },
    "medications": {
      "type": "array",
      "title": "Medications",
      "items": {
        "type": "string"
      }
    },
    "medical_notes": {
      "type": "string",
      "title": "Medical Notes"
    },
    "dietary_requirements": {
      "type": "string",
      "title": "Dietary Requirements"
    },
    "section_504_plan": {
      "type": "boolean",
      "title": "504 Plan on File",
      "default": false
    },
    "section_504_details": {
      "type": "string",
      "title": "504 Plan Details"
    },
    "section_504_document_url": {
      "type": "string",
      "format": "uri",
      "title": "504 Plan Document URL"
    },
    "iep_on_file": {
      "type": "boolean",
      "title": "IEP on File",
      "default": false
    },
    "iep_details": {
      "type": "string",
      "title": "IEP Details"
    },
    "support_plans": {
      "type": "array",
      "title": "Support Plans",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "file_url": {
            "type": "string",
            "format": "uri"
          },
          "file_name": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "file_url",
          "file_name"
        ]
      }
    },
    "emergency_contacts": {
      "type": "array",
      "title": "Emergency Contacts",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "authorized_pickups": {
      "type": "array",
      "title": "Authorized Pickups",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    },
    "custody_alerts": {
      "type": "string",
      "title": "Custody or Release Alerts"
    },
    "username": {
      "type": "string",
      "title": "Login Username"
    },
    "password": {
      "type": "string",
      "title": "Login Password"
    },
    "email": {
      "type": "string",
      "title": "Email (for SSO / password reset)"
    },
    "password_reset_required": {
      "type": "boolean",
      "title": "Password Reset Required",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "title": "Failed Login Attempts",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "title": "Locked Until"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Login At"
    }
  },
  "required": [
    "student_name",
    "student_number",
    "school_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}