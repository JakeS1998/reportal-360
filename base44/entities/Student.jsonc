{
  "name": "Student",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "student_number": {
      "type": "string",
      "title": "Student Number"
    },
    "state_student_id": {
      "type": "string",
      "title": "State Student ID"
    },
    "grade_level": {
      "type": "string",
      "title": "Grade Level"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "homeroom": {
      "type": "string",
      "title": "Homeroom"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "transferred"
      ],
      "default": "active"
    },
    "gender": {
      "type": "string",
      "title": "Gender",
      "enum": [
        "Male",
        "Female"
      ]
    },
    "race_ethnicity": {
      "type": "string",
      "title": "Race/Ethnicity",
      "enum": [
        "White",
        "Black",
        "Hispanic",
        "Asian",
        "American Indian",
        "Two or more",
        "Native Hawaiian"
      ]
    },
    "economically_disadvantaged": {
      "type": "boolean",
      "title": "Economically Disadvantaged",
      "default": false
    },
    "english_learner": {
      "type": "boolean",
      "title": "English Learner",
      "default": false
    },
    "disability": {
      "type": "boolean",
      "title": "Has Disability",
      "default": false
    },
    "lunch_status": {
      "type": "string",
      "title": "Lunch Status",
      "enum": [
        "Free",
        "Reduced",
        "Paid"
      ]
    },
    "username": {
      "type": "string",
      "title": "Login Username"
    },
    "password": {
      "type": "string",
      "title": "Login Password"
    },
    "email": {
      "type": "string",
      "title": "Email (for SSO / password reset)"
    },
    "password_reset_required": {
      "type": "boolean",
      "title": "Password Reset Required",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "title": "Failed Login Attempts",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "title": "Locked Until"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Login At"
    }
  },
  "required": [
    "student_name"
  ]
}