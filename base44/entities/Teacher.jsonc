{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "title": "Username"
    },
    "password": {
      "type": "string",
      "title": "Password"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "system_code": {
      "type": "string",
      "title": "System Code"
    },
    "school_name": {
      "type": "string",
      "title": "School Name"
    },
    "system_name": {
      "type": "string",
      "title": "System Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "area",
        "manager",
        "teacher"
      ],
      "default": "teacher"
    },
    "teacher_id": {
      "type": "string",
      "title": "Teacher ID"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "room": {
      "type": "string",
      "title": "Assigned Room"
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "password_reset_required": {
      "type": "boolean",
      "title": "Password Reset Required",
      "default": false
    },
    "failed_login_attempts": {
      "type": "number",
      "title": "Failed Login Attempts",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "title": "Locked Until"
    },
    "mfa_enabled": {
      "type": "boolean",
      "title": "MFA Enabled",
      "default": true
    },
    "mfa_code": {
      "type": "string",
      "title": "MFA Code"
    },
    "mfa_code_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "MFA Code Expires At"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Login At"
    }
  },
  "required": [
    "username",
    "password",
    "school_code",
    "system_code",
    "role",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}