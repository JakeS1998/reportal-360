{
  "name": "SchoolTimetable",
  "type": "object",
  "properties": {
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "scope": {
      "type": "string",
      "title": "Applies To",
      "enum": [
        "school",
        "grade"
      ],
      "default": "school"
    },
    "grade_level": {
      "type": "string",
      "title": "Grade Level"
    },
    "scheduling_model": {
      "type": "string",
      "title": "Scheduling Model",
      "enum": [
        "traditional",
        "rotating_block",
        "flexible_weekly"
      ],
      "default": "traditional"
    },
    "school_days": {
      "type": "array",
      "title": "School Days",
      "items": {
        "type": "string"
      }
    },
    "cycle_day_types": {
      "type": "array",
      "title": "Cycle Day Types",
      "items": {
        "type": "string"
      }
    },
    "cycle_start_date": {
      "type": "string",
      "format": "date",
      "title": "Cycle Start Date"
    },
    "flexible_slots": {
      "type": "array",
      "title": "Flexible Weekly Slots",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "day_of_week",
          "start",
          "end"
        ]
      }
    },
    "school_start": {
      "type": "string",
      "title": "School Start (HH:MM)"
    },
    "school_end": {
      "type": "string",
      "title": "Calculated School End (HH:MM)"
    },
    "detention_start_time": {
      "type": "string",
      "title": "Detention Start Override (HH:MM)"
    },
    "homeroom_start": {
      "type": "string",
      "title": "Homeroom Start (HH:MM)"
    },
    "homeroom_end": {
      "type": "string",
      "title": "Homeroom End (HH:MM)"
    },
    "break_start": {
      "type": "string",
      "title": "Break Start (HH:MM)"
    },
    "break_end": {
      "type": "string",
      "title": "Break End (HH:MM)"
    },
    "lunch_start": {
      "type": "string",
      "title": "Lunch Start (HH:MM)"
    },
    "lunch_end": {
      "type": "string",
      "title": "Lunch End (HH:MM)"
    },
    "period_count": {
      "type": "number",
      "title": "Periods Per Day",
      "default": 6
    },
    "lesson_duration": {
      "type": "number",
      "title": "Lesson Duration (Minutes)",
      "default": 60
    },
    "periods": {
      "type": "array",
      "title": "Confirmed Period Times",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    }
  },
  "required": [
    "school_code",
    "scope",
    "school_start",
    "school_end",
    "break_start",
    "break_end",
    "lunch_start",
    "lunch_end",
    "period_count",
    "lesson_duration"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}