{
  "name": "SchoolTimetable",
  "type": "object",
  "properties": {
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "scope": {
      "type": "string",
      "title": "Applies To",
      "enum": [
        "school",
        "grade"
      ],
      "default": "school"
    },
    "grade_level": {
      "type": "string",
      "title": "Grade Level"
    },
    "school_start": {
      "type": "string",
      "title": "School Start (HH:MM)"
    },
    "school_end": {
      "type": "string",
      "title": "School End (HH:MM)"
    },
    "homeroom_start": {
      "type": "string",
      "title": "Homeroom Start (HH:MM)"
    },
    "homeroom_end": {
      "type": "string",
      "title": "Homeroom End (HH:MM)"
    },
    "break_start": {
      "type": "string",
      "title": "Break Start (HH:MM)"
    },
    "break_end": {
      "type": "string",
      "title": "Break End (HH:MM)"
    },
    "lunch_start": {
      "type": "string",
      "title": "Lunch Start (HH:MM)"
    },
    "lunch_end": {
      "type": "string",
      "title": "Lunch End (HH:MM)"
    },
    "period_count": {
      "type": "number",
      "title": "Periods Per Day",
      "default": 6
    },
    "periods": {
      "type": "array",
      "title": "Confirmed Period Times",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    }
  },
  "required": [
    "school_code",
    "scope",
    "school_start",
    "school_end",
    "break_start",
    "break_end",
    "lunch_start",
    "lunch_end",
    "period_count"
  ]
}